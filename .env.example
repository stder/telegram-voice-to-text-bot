# Token from @BotFather
BOT_TOKEN=

# tiny | base | small | medium | large-v3 | large-v3-turbo
# large-v3-turbo — best speed/accuracy
WHISPER_MODEL=large-v3-turbo

# int8 — fast and small memory usage. float32 — more accurate, but slower and uses more memory.
WHISPER_COMPUTE_TYPE=int8

# Empty = auto-detect language, or specify a language code (e.g. en, ru, fr, etc.)
WHISPER_LANGUAGE=

# 0 = core count, 1 = 1 thread, 2 = 2 threads, etc. (for large models, more threads = faster)
WHISPER_CPU_THREADS=0

# 1 — less accurate, but faster. 5 — most accurate, but slower. (for large models, more beams = slower)
WHISPER_BEAM_SIZE=5

# Telegram user IDs that are allowed to use the bot. Leave empty to allow all users.
ALLOWED_USER_IDS=

# Audio duration limit in seconds. 0 = no limit.
MAX_DURATION_SEC=0

# Optional. Only used while downloading the model from Hugging Face on first start.
# Without it the download is anonymous: it works, but shares a low per-IP rate limit
# and prints a warning on every start. A free read token from
# https://huggingface.co/settings/tokens removes both.
HF_TOKEN=
